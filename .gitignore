*.pch
*.sbr
*.pdb
*.cod
*.i
*.bsc
*.map
*.res
*.tlog
*.idb
*.plg
*.opt
*.recipe
*.lastbuildstate
*.aps

# Compiled binaries and libraries
*.exe
*.dll
*.lib
*.a
*.sys
*.tlb
*.obj

# User-specific Visual Studio settings & temporary folders
*.user
.vs/
Debug/
Release/
x64/
x86/

